{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "Agromemnon",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "Agromemnon"
  },
  "runtimes": [
    {
      "name": "Agromemnon",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/Agromemnon/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "MANDI_PRICES_TABLE",
          "value": "Agromemnon-mandi-prices"
        },
        {
          "name": "SOIL_NUTRIENTS_TABLE",
          "value": "Agromemnon-soil-nutrients"
        },
        {
          "name": "SCHEME_KB_ID",
          "value": "IY3TP8DVNA"
        },
        {
          "name": "SCHEME_KB_REGION",
          "value": "us-east-1"
        },
        {
          "name": "AGENTCORE_MEMORY_NAME",
          "value": "AgromemnonFarmerMemory"
        },
        {
          "name": "GEMINI_API_KEY_SECRET",
          "value": "Agromemnon/gemini-api-key"
        },
        {
          "name": "LEAF_DISEASE_ENDPOINT",
          "value": "agromemnon-leaf-disease"
        },
        {
          "name": "LEAF_DISEASE_REGION",
          "value": "us-east-1"
        },
        {
          "name": "VISION_MODEL_ID",
          "value": "us.anthropic.claude-sonnet-4-6"
        },
        {
          "name": "VISION_MODEL_REGION",
          "value": "us-east-1"
        }
      ],
      "additionalPolicies": [
        "policies/dynamodb-mandi-prices.json",
        "policies/dynamodb-soil-nutrients.json",
        "policies/bedrock-scheme-kb.json",
        "policies/agentcore-memory.json",
        "policies/gemini-api-key.json",
        "policies/sagemaker-leaf-disease.json",
        "policies/bedrock-vision-model.json"
      ]
    }
  ],
  "memories": [
    {
      "name": "AgromemnonFarmerMemory",
      "eventExpiryDuration": 365,
      "strategies": [
        {
          "type": "USER_PREFERENCE",
          "name": "FarmerPreferences",
          "description": "How this farmer farms and prefers to be advised: crops grown, irrigation available, land size, language.",
          "namespaceTemplates": [
            "farmer/{actorId}/profile"
          ]
        },
        {
          "type": "SEMANTIC",
          "name": "FarmFacts",
          "description": "Durable facts the farmer has stated: soil health card readings, plot sizes, sowing dates, schemes applied for, past crop problems.",
          "namespaceTemplates": [
            "farmer/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "name": "ConversationSummaries",
          "description": "One running summary per conversation, so advice given weeks ago can be followed up.",
          "namespaceTemplates": [
            "farmer/{actorId}/chats/{sessionId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
