{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExternalApiKeys",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:*:*:secret:Agromemnon/weatherapi-key*",
        "arn:aws:secretsmanager:*:*:secret:Agromemnon/data-gov-api-key*"
      ]
    }
  ]
}
